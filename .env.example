# Used by docker-compose.yml. Copy to ./.env (git-ignored) and fill in YOUR OWN values.
# NEVER commit real credentials. Production secrets belong in the hosting provider's secret manager.

DB_URL=jdbc:postgresql://host.docker.internal:5432/your_database
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_-base64_48

# Only needed with: docker compose --profile local-db up
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=choose_a_local_password
# (then use DB_URL=jdbc:postgresql://db:5432/mindmaze, DB_USERNAME/DB_PASSWORD = the values above)

# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# FRONTEND_URL=http://localhost:3000
# BREVO_API_KEY=
