# AlgoArena backend - environment template
# Copy to backend/.env (git-ignored) for local development, or set these in your host's
# environment/secret manager for deployed environments.
# NEVER commit a real .env file or paste real credentials into any tracked file.

# --- Database (REQUIRED - no defaults; the app will not start without them) ---------------
DB_URL=jdbc:postgresql://localhost:5432/your_database
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# --- JWT signing secret (REQUIRED) ----------------------------------------------------------
# At least 32 random characters. Generate one with:  openssl rand -base64 48
# The app refuses to start if this is short or looks like a placeholder/known value.
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_-base64_48

# --- Browser origins (CORS + WebSocket) -------------------------------------------------------
# Exact origins only, comma separated, no wildcards. FRONTEND_URL is always trusted as well.
# Defaults (local dev only): http://localhost:5173, http://localhost:3000
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
FRONTEND_URL=http://localhost:5173

# --- Email (optional locally) ---------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME=AlgoArena

# --- DSA Competition (OFF by default) -------------------------------------------------------
# Turn on only after running db/competition/001_create_competition_tables.sql on your database.
# COMPETITION_ENABLED=true
# COMPETITION_MIN_PLAYERS=2
# COMPETITION_MAX_PLAYERS=25          # hard cap 25
# COMPETITION_QUESTION_COUNT=10
# COMPETITION_DURATION_SECONDS=1200
# COMPETITION_COUNTDOWN_SECONDS=10

# --- Local development helpers (never enable in deployed environments) -----------------------
# DEV_LOG_RESET_LINKS=true     # log the password-reset link when BREVO_API_KEY is empty
# SHOW_SQL=true
# LOG_LEVEL_APP=DEBUG
